+mod tests {
+    use super::*;
+    use crate::errors::idevice_error_free;
+
+    struct CancelReset;
+
+    impl Drop for CancelReset {
+        fn drop(&mut self) {
+            aurora_pairable_host_set_cancelled(false);
+        }
+    }
+
+    #[test]
+    fn cancelled_accept_is_repeatable_and_clears_the_output() {
+        let _reset = CancelReset;
+        let name = CString::new("Aurora Location test").unwrap();
+        aurora_pairable_host_set_cancelled(true);
+
+        for _ in 0..2 {
+            let mut output = std::ptr::dangling_mut::<RpPairingFileHandle>();
+            let error = unsafe {
+                aurora_pairable_host_accept(
+                    name.as_ptr(),
+                    std::ptr::null(),
+                    None,
+                    null_mut(),
+                    None,
+                    null_mut(),
+                    None,
+                    null_mut(),
+                    &mut output,
+                )
+            };
+
+            assert!(!error.is_null());
+            assert_eq!(
+                unsafe { (*error).code },
+                IdeviceError::CanceledByUser.code()
+            );
+            assert!(output.is_null());
